{
  "manifest_version": 3,
  "name": "VK Toolkit",
  "version": "0.2.0",
  "description": "Модульный набор инструментов для VK.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs"],
  "host_permissions": ["https://vk.ru/*", "https://m.vk.ru/*", "https://vk.com/*", "https://m.vk.com/*"],
  "action": {
    "default_title": "VK Toolkit",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://vk.ru/*", "https://m.vk.ru/*", "https://vk.com/*", "https://m.vk.com/*"],
      "js": ["src/bootstrap.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*"],
      "matches": ["https://vk.ru/*", "https://m.vk.ru/*", "https://vk.com/*", "https://m.vk.com/*"]
    }
  ]
}
