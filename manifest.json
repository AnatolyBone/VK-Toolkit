{
  "manifest_version": 3,
  "name": "VK Toolkit",
  "version": "0.8.0",
  "description": "Модульный набор инструментов для VK.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://vk.ru/*",
    "https://m.vk.ru/*",
    "https://vk.com/*",
    "https://m.vk.com/*",
    "https://*.userapi.com/*",
    "https://*.vkuseraudio.net/*",
    "https://*.vkuserphoto.ru/*",
    "https://*.vkcdn.ru/*",
    "https://*.vkvideo.ru/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "VK Toolkit",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://vk.ru/*", "https://m.vk.ru/*", "https://vk.com/*", "https://m.vk.com/*"],
      "js": ["src/bootstrap.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/runtime.js", "src/core/*.js", "src/modules/*/*.js"],
      "matches": ["https://vk.ru/*", "https://m.vk.ru/*", "https://vk.com/*", "https://m.vk.com/*"]
    }
  ]
}
